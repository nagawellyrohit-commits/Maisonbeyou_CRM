# Copy this file to .env and fill in the values from your SMS provider.
# Keep .env private; it is excluded from Git.
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=

# Optional alternatives supported by the server:
TWOFACTOR_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional WhatsApp appointment/payment notifications (choose one provider)
# Twilio requires a WhatsApp-enabled sender such as whatsapp:+14155238886.
TWILIO_WHATSAPP_FROM=
# Or use Meta WhatsApp Cloud API:
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Automatic gift voucher delivery uses an approved template outside the WhatsApp customer-service window.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Set to true only when the approved Meta template has an image header.
WHATSAPP_TEMPLATE_HEADER_MEDIA=false
# Public HTTPS origin used by WhatsApp to fetch voucher images, e.g. https://crm.example.com
PUBLIC_BASE_URL=
# Optional Twilio Content Template SID for WhatsApp voucher delivery.
TWILIO_WHATSAPP_CONTENT_SID=
# Meta webhook verification and delivery status callbacks.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Optional client email notifications (choose one provider)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional signed delivery-status webhook from Resend.
RESEND_WEBHOOK_SECRET=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Optional signed delivery-status webhook public key from SendGrid.
SENDGRID_WEBHOOK_PUBLIC_KEY=
