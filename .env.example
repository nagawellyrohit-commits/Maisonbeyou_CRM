# Copy this file to .env and fill in the values from your SMS provider.
# Keep .env private; it is excluded from Git.
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=

# Optional alternatives supported by the server:
TWOFACTOR_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# MSG91 Direct OTP API (keep these server-only; do not prefix with VITE_)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_LENGTH=6
MSG91_OTP_EXPIRY=5
# Local/demo OTP mode: displays an OTP in the login screen instead of sending SMS.
OTP_DEMO_MODE=false

# Optional WhatsApp appointment/payment notifications (choose one provider)
# Twilio requires a WhatsApp-enabled sender such as whatsapp:+14155238886.
TWILIO_WHATSAPP_FROM=
# Or use Meta WhatsApp Cloud API:
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Automatic gift voucher delivery uses an approved template outside the WhatsApp customer-service window.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Set to true only when the approved Meta template has an image header.
WHATSAPP_TEMPLATE_HEADER_MEDIA=false
# Approved WhatsApp invoice template with a DOCUMENT header for manual invoice delivery.
WHATSAPP_INVOICE_TEMPLATE_NAME=maison_beyou_invoice_delivery
# Twilio equivalent Content SID. Required when using Twilio WhatsApp for invoice delivery.
TWILIO_WHATSAPP_INVOICE_CONTENT_SID=
# Public HTTPS origin used by WhatsApp to fetch voucher images, e.g. https://crm.example.com
PUBLIC_BASE_URL=
# Optional Twilio Content Template SID for WhatsApp voucher delivery.
TWILIO_WHATSAPP_CONTENT_SID=
# Approved template/content used by automated branch, user, and client notifications.
TWILIO_NOTIFICATION_CONTENT_SID=
WHATSAPP_NOTIFICATION_TEMPLATE_NAME=
# The CRM uses these default Meta template names; create matching approved templates with the exact bodies in server/index.js.
# Per-event name overrides are optional.
WHATSAPP_TEMPLATE_BRANCH_ACCESS_NAME=
WHATSAPP_TEMPLATE_ADMIN_ACCESS_NAME=
WHATSAPP_TEMPLATE_BRANCH_USER_ACCESS_NAME=
WHATSAPP_TEMPLATE_CLIENT_WELCOME_NAME=
WHATSAPP_TEMPLATE_APPOINTMENT_NAME=
WHATSAPP_TEMPLATE_PAYMENT_NAME=
# Optional per-event Twilio Content SIDs, if using Twilio instead of Meta.
TWILIO_WHATSAPP_BRANCH_ACCESS_CONTENT_SID=
TWILIO_WHATSAPP_ADMIN_ACCESS_CONTENT_SID=
TWILIO_WHATSAPP_BRANCH_USER_ACCESS_CONTENT_SID=
TWILIO_WHATSAPP_CLIENT_WELCOME_CONTENT_SID=
TWILIO_WHATSAPP_APPOINTMENT_CONTENT_SID=
TWILIO_WHATSAPP_PAYMENT_CONTENT_SID=
# Meta webhook verification and delivery status callbacks.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Direct email from your mailbox through its SMTP service (Google Workspace, Microsoft 365, or your email host).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
